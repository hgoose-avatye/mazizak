{
  "name": "manzizak-p0-prototype",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host --port 4319",
    "build": "npm run check:sfx && tsc --noEmit && vite build",
    "preview": "vite preview --host --port 4320",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check:dist": "node scripts/check-dist.mjs",
    "check:load": "node scripts/load-regression.mjs",
    "bench:load": "node scripts/bench-load.mjs",
    "pack:sfx": "node --experimental-transform-types --no-warnings scripts/audio/pack-sfx.mjs",
    "check:sfx": "node --experimental-transform-types --no-warnings scripts/audio/pack-sfx.mjs --check",
    "check:play": "node scripts/play-all.mjs"
  },
  "dependencies": {
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/three": "^0.187.0",
    "libflacjs": "5.6.0",
    "playwright-core": "^1.65.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.7"
  }
}
